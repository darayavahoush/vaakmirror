# Copy this to .env and adjust if needed.
# Matches the docker-compose.yml service by default — note port 5433, not
# the usual 5432, since 5432 is very often already taken by a Postgres
# you've got running locally for something else.
DATABASE_URL=postgresql+psycopg2://vaakmirror:vaakmirror@localhost:5433/vaakmirror

# Comma-separated list of origins allowed to call this API.
# Vite's default dev server port.
CORS_ORIGINS=http://localhost:5173
