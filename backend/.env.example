# Copy this to .env and adjust if needed.
#
# If you're using your own local Postgres (Homebrew, etc.) instead of the
# docker-compose service, this should point at whatever port it's on —
# usually the default 5432.
DATABASE_URL=postgresql+psycopg2://vaakmirror:vaakmirror@localhost:5432/vaakmirror

# Comma-separated list of origins allowed to call this API. Currently
# UNUSED — the API allows all origins for now since there's no auth yet
# (see main.py). Kept here so it's ready to wire back in once real auth
# gets added and an exact-origin allowlist is worth enforcing again.
CORS_ORIGINS=http://localhost:5173
